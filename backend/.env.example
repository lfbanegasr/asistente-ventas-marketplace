# Variables de entorno para el backend
# Copia este archivo a .env y completa los valores

# Contraseña de acceso — mínimo 16 caracteres, guárdala en tu gestor de contraseñas
APP_PASSWORD=una-clave-larga-de-prueba-cambiala

# Secreto para firmar tokens JWT — genera uno aleatorio de 32+ caracteres
JWT_SECRET=cambia-este-secreto-jwt-por-uno-aleatorio-muy-seguro

# Base de datos PostgreSQL Cloud (Neon, Supabase, Render, Railway, etc.)
# 100% GRATIS y persistente sin necesidad de pagar ni configurar volúmenes en Railway.
# Ejemplo Neon (gratis, recomendado): postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# Ejemplo Supabase (gratis): postgresql://postgres:pass@db.xyz.supabase.co:5432/postgres
# (Si no configuras DATABASE_URL en desarrollo local, iniciará en memoria temporalmente)
DATABASE_URL=postgresql://usuario:password@ep-xyz.neon.tech/neondb?sslmode=require

# Clave de la API de Gemini (opcional, sin ella se usa respuesta base predeterminada)
GEMINI_API_KEY=pega_aqui_tu_clave_de_gemini

# Modelo de Gemini a usar
GEMINI_MODEL=gemini-2.5-flash-lite

# Orígenes permitidos para CORS (separados por coma)
# Incluye la URL de tu frontend desplegado (Vercel/Netlify) y localhost para desarrollo
CORS_ORIGINS=http://localhost:5173,https://tu-frontend.vercel.app

# Puerto del servidor (Railway/Render lo configuran automáticamente mediante process.env.PORT)
PORT=3001
